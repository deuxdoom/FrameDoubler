<Window x:Class="FrameDoubler.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="FrameDoubler" Width="1180" Height="740" WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="Assets/app.ico" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/></Window.InputBindings>
 <Border x:Name="WindowBorder" Background="{StaticResource BackgroundBrush}" BorderBrush="#30373C" BorderThickness="1" CornerRadius="12"><Grid>
 <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="TitleBar"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center"><Image Source="Assets/icon.png" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="FrameDoubler" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Border x:Name="PageSwitch" Height="34" CornerRadius="17" Background="#111619" BorderBrush="#46535B" BorderThickness="1" Padding="2" Margin="26,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal"><RadioButton x:Name="CapturePageButton" GroupName="Pages" Style="{StaticResource PageSegment}" Content="캡처 미리보기" Tag="capture" Checked="PageChecked"/><RadioButton x:Name="ConvertPageButton" GroupName="Pages" Style="{StaticResource PageSegment}" Content="파일 변환" Tag="convert" Checked="PageChecked"/></StackPanel></Border></StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Border x:Name="LanguageSwitch" Width="124" Height="32" CornerRadius="16" Background="#111619" BorderBrush="#46535B" BorderThickness="1" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="언어 · Language"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="LanguageThumb" CornerRadius="13" Background="#FF6B3D"><Border.RenderTransform><TranslateTransform x:Name="LanguageThumbShift"/></Border.RenderTransform></Border><Button x:Name="KoreanButton" Content="한국어" Tag="ko" Style="{StaticResource LanguageSegment}" Click="LanguageClicked" AutomationProperties.Name="한국어"/><Button x:Name="EnglishButton" Grid.Column="1" Content="EN" Tag="en" Style="{StaticResource LanguageSegment}" Click="LanguageClicked" AutomationProperties.Name="English"/></Grid></Border>
   <Button x:Name="UpdatesButton" Style="{StaticResource CaptionButton}" FontFamily="Segoe Fluent Icons" Content="&#xE895;" Click="UpdatesClicked" ToolTip="업데이트"/>
   <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" FontFamily="Segoe Fluent Icons" Content="&#xE713;" Click="SettingsClicked" ToolTip="설정"/>
   <Border Width="1" Background="#30373C" Margin="9,16"/>
   <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" FontFamily="Segoe Fluent Icons" Content="&#xE921;" Click="MinimizeClicked"/>
   <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" FontFamily="Segoe Fluent Icons" Content="&#xE922;" Visibility="Collapsed" IsEnabled="False"/>
   <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" FontFamily="Segoe Fluent Icons" Content="&#xE8BB;" Click="CloseClicked" Margin="0,0,6,0"/>
  </StackPanel>
 </Grid>
 <Grid x:Name="ConvertHeader" Grid.Row="1" Margin="28,16,28,24">
  <StackPanel><TextBlock x:Name="Tagline" Text="30fps 게임 녹화를 60fps로 변환" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Subtitle" Text="반복된 중복 프레임을 찾아내고, 그 자리를 RIFE AI 보간 프레임으로 채웁니다." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
 </Grid>
 <Grid x:Name="ConvertBody" Grid.Row="2" Margin="28,0,28,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="326"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="QueueTitle" Text="입력 영상" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="QueueCount" Text="0" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RemoveButton" Content="선택 제거" Click="RemoveClicked" Style="{StaticResource TextButton}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="AddButton" Content="영상 추가" Click="AddClicked" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="14,5" MinHeight="32" FontSize="12"/></StackPanel></Grid>
   <Border x:Name="DropBorder" Grid.Row="1" Background="#191F23" CornerRadius="12" BorderBrush="#3A454C" BorderThickness="1" MinHeight="130"><Grid>
    <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="QueueChanged" Padding="8" SelectionMode="Extended" AllowDrop="True" PreviewMouseLeftButtonDown="QueuePressed" PreviewMouseMove="QueueDragMove" DragOver="QueueDragOver" Drop="QueueDropped">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#252E33"/><Setter TargetName="Card" Property="BorderBrush" Value="#4B5B65"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#252E33"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F4BD83"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="128" Height="72" VerticalAlignment="Top" Margin="0,2,0,0"><Border CornerRadius="6" Background="#111619" BorderBrush="#30373C" BorderThickness="1"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE714;" FontSize="20" Foreground="#5D6A72" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border><Border CornerRadius="5" Background="#E614181B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="7,1,7,2"><TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="#F3F1EB"/></Border></Grid><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Input}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Metadata}" Foreground="#A6B1B8" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding Details}" Foreground="#A6B1B8" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" Foreground="#F4BD83" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button x:Name="EmptyPanel" Click="AddClicked" Style="{StaticResource DropButton}" AutomationProperties.Name="영상 파일 선택"><StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Border x:Name="DropIcon" Width="56" Height="56" Background="#30271F" CornerRadius="16" HorizontalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" FontSize="25" Foreground="#FF8C60" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock x:Name="DropText" Text="영상을 끌어 놓으세요" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,8"/><TextBlock x:Name="DropHint" Text="또는 클릭하여 파일을 선택하세요" Foreground="#A6B1B8" FontSize="13" TextAlignment="Center"/></StackPanel></Button>
   </Grid></Border>
   <Grid x:Name="MetricsPanel" Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12"><StackPanel><TextBlock x:Name="FileMetricLabel" Text="파일 프레임레이트" FontSize="12" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="FileMetric" Text="—" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="fps" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,5"/></StackPanel></StackPanel></Border>
    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16,12"><StackPanel><TextBlock x:Name="MotionMetricLabel" Text="실제 움직임" FontSize="12" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="MotionMetric" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="#FF8C60"/><TextBlock Text="fps" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="7,0,0,5"/></StackPanel></StackPanel></Border>
   </Grid>
   <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="OpenButton" Content="결과 열기" Click="OpenClicked" IsEnabled="False" Style="{StaticResource TextButton}"/><Button x:Name="FolderButton" Content="폴더 열기" Click="OpenFolderClicked" Style="{StaticResource TextButton}" Margin="12,0,0,0"/></StackPanel>
   <Expander x:Name="Details" Grid.Row="4" Header="처리 기록" Margin="0,6,0,0"><TextBox x:Name="LogBox" Height="110" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="12"/></Expander>
  </Grid>
  <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20,20,12,20"><ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel x:Name="SettingsPanel">
   <TextBlock x:Name="SettingsTitle" Text="출력 설정" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <TextBlock x:Name="FpsLabel" Text="프레임레이트" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FpsBox"/>
   <TextBlock x:Name="PresetLabel" Text="프리셋" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PresetBox" SelectionChanged="OptionsChanged" Margin="0,6,0,16"/>
   <TextBlock x:Name="OutputLabel" Text="저장 위치" Style="{StaticResource FieldLabel}"/>
   <Grid Margin="0,6,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox" MinWidth="0"/><TextBlock x:Name="OutputHint" Text="원본 영상과 같은 폴더" Foreground="#6F7C84" Margin="13,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Button x:Name="BrowseButton" Grid.Column="2" FontFamily="Segoe Fluent Icons" Content="&#xE838;" Click="ChooseFolder" Padding="0"/></Grid>
   <CheckBox x:Name="VerifyCheck" Content="변환 후 품질·동기 검증" IsChecked="False" FontSize="12" Margin="0,0,0,12"/>
   <Grid Margin="0,4,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="EstimateTitle" Text="예상 소요 시간" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="EstimateValue" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="#FF8C60" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="EstimateHint" Foreground="#A6B1B8" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="EstimateAgain" Grid.Column="1" FontFamily="Segoe Fluent Icons" Content="&#xE72C;" Style="{StaticResource TextButton}" Click="EstimateAgainClicked" VerticalAlignment="Top"/></Grid>
   <!-- Advanced options live in Settings → Advanced. The same controls are lent to that page while it is open. -->
   <ContentControl x:Name="AdvancedHost" Visibility="Collapsed"><StackPanel x:Name="AdvancedPanel">
    <TextBlock x:Name="DeviceLabel" Text="추론 장치" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DeviceBox"/>
    <TextBlock x:Name="EncoderLabel" Text="인코더" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="EncoderBox"/>
    <CheckBox x:Name="HardwareCheck" Content="하드웨어 인코딩 사용" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged" FontSize="12"/>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="ModelLabel" Text="RIFE 모델" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><Border x:Name="ModelHelp" Width="16" Height="16" CornerRadius="8" BorderBrush="#60717C" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Background="Transparent" Cursor="Help" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000"><TextBlock Text="?" FontSize="10" FontWeight="SemiBold" Foreground="#A6B1B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel><ComboBox x:Name="ModelBox"/>
    <TextBlock x:Name="HudLabel" Text="고정 HUD 영역 (선택)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HudBox" Margin="0,6,0,16"/>
    <TextBlock x:Name="HardwareText" Text="하드웨어 확인 중…" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></ContentControl>
  </StackPanel></ScrollViewer></Border>
 </Grid>
 <Border x:Name="ConvertFooter" Grid.Row="3" Background="#191F23" BorderBrush="#30373C" BorderThickness="0,1,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ProgressBar x:Name="ProgressBar" Maximum="1" Foreground="#FF6B3D" Background="Transparent" BorderThickness="0"/>
  <Grid Grid.Row="1" Margin="28,16,28,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="StatusText" Text="영상을 추가해 주세요." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="RateText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <Button x:Name="CancelButton" Grid.Column="1" Content="취소" Click="CancelClicked" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
   <Button x:Name="SelectedButton" Grid.Column="3" Content="선택 변환" Click="SelectedClicked" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
   <Button x:Name="StartButton" Grid.Column="5" Content="일괄 변환" Click="StartClicked" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
  </Grid>
 </Grid></Border>
 <ContentControl x:Name="CaptureHost" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"/>
 </Grid></Border>
</Window>

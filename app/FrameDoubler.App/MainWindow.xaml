<Window x:Class="FrameDoubler.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FrameDoubler" Width="1280" Height="840" MinWidth="960" MinHeight="720" Icon="Assets/app.ico" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
 <Grid Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Image Source="Assets/icon.png" Width="44" Height="44" Margin="0,0,14,0"/><StackPanel><TextBlock Text="FrameDoubler" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Tagline" Text="프레임 사이를, 움직임으로." Foreground="{StaticResource MutedBrush}" FontSize="13"/></StackPanel></StackPanel>
   <ComboBox x:Name="LanguageBox" Grid.Column="1" Margin="0,4,14,4" SelectionChanged="LanguageChanged"/>
   <Button x:Name="AddButton" Grid.Column="2" Content="영상 추가" Background="#FF6B3D" Foreground="#14181B" BorderBrush="#FF6B3D" Click="AddClicked"/>
  </Grid>
  <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="14,10" Margin="0,0,0,18"><TextBlock x:Name="HardwareText" Text="하드웨어를 확인하고 있습니다…" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock x:Name="QueueTitle" Text="입력 영상" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RemoveButton" Content="선택 제거" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="RemoveClicked" Padding="12,5"/></DockPanel>
    <Border Grid.Row="1" BorderBrush="#46535B" BorderThickness="1" CornerRadius="10" Background="#1D2327"><Grid>
     <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" Foreground="#F3F1EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="QueueChanged">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,1"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Input}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Metadata}" Foreground="#A6B1B8" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" Foreground="#F4BD83" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25"><TextBlock Text="＋" FontSize="42" Foreground="#FF6B3D" HorizontalAlignment="Center"/><TextBlock x:Name="DropText" Text="영상을 끌어놓으세요" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,8"/><TextBlock x:Name="DropHint" Text="30fps 원본과 60fps로 녹화된 게임 영상" Foreground="#A6B1B8" TextAlignment="Center"/></StackPanel>
    </Grid></Border>
    <DockPanel Grid.Row="2" Margin="0,12,0,8"><Button x:Name="OpenButton" Content="결과 파일 열기" Click="OpenClicked" IsEnabled="False"/><Button x:Name="FolderButton" Content="출력 폴더 열기" Click="OpenFolderClicked" Margin="10,3,0,3"/><Button x:Name="UpdatesButton" Content="업데이트" Click="UpdatesClicked" Margin="10,3,0,3"/></DockPanel>
    <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Background="#111619" BorderBrush="#46535B"/>
   </Grid>
   <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel">
    <TextBlock x:Name="SettingsTitle" Text="출력 설정" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock x:Name="OutputLabel" Text="저장 폴더" Foreground="#A6B1B8"/><DockPanel Margin="0,5,0,12"><Button Content="…" DockPanel.Dock="Right" Width="42" Margin="6,0,0,0" Click="ChooseFolder"/><TextBox x:Name="OutputBox" ToolTip="비워 두면 원본 영상과 같은 폴더에 저장합니다."/></DockPanel>
    <TextBlock x:Name="PresetLabel" Text="프리셋" Foreground="#A6B1B8"/><ComboBox x:Name="PresetBox" SelectionChanged="OptionsChanged"/>
    <TextBlock x:Name="FpsLabel" Text="목표 프레임레이트" Foreground="#A6B1B8"/><ComboBox x:Name="FpsBox"/>
    <TextBlock x:Name="CodecLabel" Text="코덱" Foreground="#A6B1B8"/><ComboBox x:Name="CodecBox" SelectionChanged="OptionsChanged"/>
    <TextBlock x:Name="DeviceLabel" Text="추론 장치" Foreground="#A6B1B8"/><ComboBox x:Name="DeviceBox"/>
    <TextBlock x:Name="EncoderLabel" Text="인코더" Foreground="#A6B1B8"/><ComboBox x:Name="EncoderBox"/>
    <CheckBox x:Name="HardwareCheck" Content="하드웨어 인코딩 사용" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
    <CheckBox x:Name="VerifyCheck" Content="변환 후 품질·동기 검증" IsChecked="True"/>
    <Expander x:Name="Advanced" Header="고급 설정" Foreground="#A6B1B8" Margin="0,12,0,4"><StackPanel Margin="0,10,4,0">
     <TextBlock x:Name="ModelLabel" Text="RIFE 모델"/><ComboBox x:Name="ModelBox"/>
     <TextBlock x:Name="QualityLabel" Text="품질 (낮을수록 고화질)"/><Slider x:Name="QualitySlider" Minimum="1" Maximum="51" Value="19" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10"/>
     <TextBlock x:Name="BitrateLabel" Text="목표 비트레이트 (예: 24M, 선택)"/><TextBox x:Name="BitrateBox" Margin="0,5,0,12"/>
     <TextBlock x:Name="HudLabel" Text="고정 HUD 영역 (X,Y,W,H; 선택)"/><TextBox x:Name="HudBox" Margin="0,5,0,8"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="ProgressBar" Foreground="#FF6B3D" Background="#252D32" BorderThickness="0" Maximum="1"/>
   <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="영상을 추가해 주세요." FontWeight="SemiBold"/><TextBlock x:Name="RateText" Foreground="#A6B1B8" FontSize="12" Margin="0,4,12,0"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="취소" Click="CancelClicked" IsEnabled="False" Margin="0,3,10,3"/><Button x:Name="StartButton" Grid.Column="2" Content="변환 시작" Click="StartClicked" Background="#FF6B3D" BorderBrush="#FF6B3D" Foreground="#14181B" IsEnabled="False"/></Grid>
  </Grid>
 </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FrameDoubler</AssemblyName>
    <ApplicationIcon>..\..\assets\icons\app-icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FrameDoubler.Core\FrameDoubler.Core.csproj" />
    <Resource Include="..\..\assets\icons\app-icon-256.png" Link="Assets\icon.png" />
    <Resource Include="..\..\assets\icons\app-icon.ico" Link="Assets\app.ico" />
  </ItemGroup>
</Project>

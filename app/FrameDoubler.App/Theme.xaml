  <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#232B30"/></Trigger>
   <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#F3F1EB"/><Setter TargetName="Box" Property="Background" Value="#2A343A"/><Setter TargetName="Underline" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="Background" Value="#33414A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="Expander"><Setter Property="Foreground" Value="#A6B1B8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" MinHeight="30"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,5"><DockPanel><TextBlock x:Name="Chevron" FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="10" DockPanel.Dock="Right" Margin="12,0,2,0" VerticalAlignment="Center"/><ContentPresenter Content="{Binding Header,RelativeSource={RelativeSource AncestorType=Expander}}"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#F4BD83"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

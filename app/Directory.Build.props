<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BaseIntermediateOutputPath>F:\Temp\FrameDoubler\dotnet\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>F:\Temp\FrameDoubler\dotnet\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <RestorePackagesPath>F:\Temp\FrameDoubler\nuget-cache</RestorePackagesPath>
  </PropertyGroup>
</Project>
